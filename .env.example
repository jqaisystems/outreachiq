# OutreachIQ - Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env.

# Required: Google Places API key (lead search)
# Get a free key at console.cloud.google.com
# Enable "Places API (New)" in the API library
GOOGLE_PLACES_API_KEY=

# Optional enrichment providers
FIRECRAWL_API_KEY=
APOLLO_API_KEY=

# Optional only if you later enable Apollo waterfall email/phone enrichment
APOLLO_WEBHOOK_URL=

# Gmail sending (optional). Requires client_secret.json + running:
#   python authorize_gmail.py
# Explicit "from" address; otherwise Gmail uses the authorized account.
GMAIL_SENDER=

# Sending safety throttle (defaults shown; keep them conservative)
SEND_DELAY_SECONDS=20
DAILY_SEND_CAP=30
FOLLOW_UP_DAYS=5
REPLY_POLL_MINUTES=360

# Your email signature (appended server-side to every outgoing email).
# Also update the preview constants in the signature section of static/app.js
# so the dashboard preview matches.
SIGNATURE_NAME=Your Name
SIGNATURE_TITLE=Your Title
SIGNATURE_WEBSITE=www.example.com
SIGNATURE_EMAIL=you@example.com
SIGNATURE_PHONE=
# Or override the whole signature block in one variable (\n = line break):
EMAIL_SIGNATURE=

# Optional path to your operator memory file (see memory.example.md)
OUTREACH_MEMORY_PATH=
